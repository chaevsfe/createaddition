{
  "schemaVersion": 1,
  "id": "createaddition",
  "version": "${version}",
  "name": "Create Fly: Crafts & Additions",
  "description": "Create Crafts & Additions port for Create Fly 26.2. Electrical age for Create: generate, store, and transfer Forge Energy with wires, motors, and machines.",
  "authors": [
    "MRH0",
    "chaevsfe"
  ],
  "contributors": [
    "chaevsfe"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/7bkhocI9",
    "sources": "https://github.com/chaevsfe/createaddition",
    "issues": "https://github.com/chaevsfe/createaddition/issues",
    "upstream": "https://modrinth.com/mod/createaddition"
  },
  "license": [
    "MIT"
  ],
  "icon": "icon_fly_port.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mrh0.createaddition.CreateAddition"
    ],
    "create_plugin": [
      "com.mrh0.createaddition.CreateAdditionPlugin"
    ],
    "client": [
      "com.mrh0.createaddition.CreateAdditionClient"
    ],
    "jei_mod_plugin": [
      "com.mrh0.createaddition.compat.jei.CreateAdditionJEI"
    ],
    "rei_common": [
      "com.mrh0.createaddition.compat.rei.CAReiCommonPlugin"
    ],
    "rei_client": [
      "com.mrh0.createaddition.compat.rei.CAReiClientPlugin"
    ]
  },
  "mixins": [
    "createaddition.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_dependency_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "create": "${create_fabric_version_range}",
    "java": ">=25"
  },
  "suggests": {
    "computercraft": "*",
    "jei": "*",
    "createreiviewer": "*",
    "roughlyenoughitems": "*"
  }
}
